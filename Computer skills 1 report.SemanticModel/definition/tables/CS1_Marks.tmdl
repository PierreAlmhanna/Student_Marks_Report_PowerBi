table CS1_Marks
	lineageTag: 318d1753-7d9a-4fd4-9a07-45ea9ac53807

	measure 'Average of 60 average per Class' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('CS1_Marks'[Class])),
				CALCULATE(AVERAGE('CS1_Marks'[Mark_60]))
			)
		formatString: 0
		lineageTag: bc3b1fb3-02a6-4542-972c-4d98d8ecc341

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

	measure Grade_Percentage = DIVIDE(COUNT(CS1_Marks[Student_id]),CALCULATE(COUNT(CS1_Marks[Student_id]),REMOVEFILTERS(CS1_Marks[Char])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed6389c0-1916-4745-af54-f97a335f8e6c

	measure ShowCards = IF(ISFILTERED(CS1_Marks[Class]), 1, 0)
		formatString: 0
		lineageTag: 95f10259-d883-4e3b-b2ba-c433f7e82b9e

	measure Overall_average = ```
			CALCULATE(AVERAGE(CS1_Marks[Mark_100]), ALL(CS1_Marks)) 
			```
		lineageTag: 5cacec3d-285e-4709-805a-28bc73b5b136

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Overall_SD = ```
			CALCULATE(STDEV.P(CS1_Marks[Mark_100]), ALL(CS1_Marks)) 
			```
		lineageTag: dc4f2385-2f60-4fc4-94c9-ad8e83ffc989

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Class_avg = AVERAGE(CS1_Marks[Mark_100])
		lineageTag: 3e8d743d-abd5-4ffc-8466-d82730d9b440

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Z_score = DIVIDE([Class_avg]-[Class_Benchmark_Avg], [Class_Benchmark_SD])
		lineageTag: a4109d7c-ca4f-49ea-a1c1-6dbbd037c908

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Consistency_Benchmark = ```
			
			-- 1. حساب متوسط الانحرافات المعيارية لكل الصفوف (المرجع)
			VAR Avg_SD_Across_All_Classes = 
			    AVERAGEX(
			        ALL(CS1_Marks[Class]), 
			        CALCULATE(STDEV.P(CS1_Marks[Mark_100]))
			    )
			
			-- 2. حساب الانحراف المعياري للصف الحالي
			VAR Current_Class_SD = STDEV.P(CS1_Marks[Mark_100])
			
			-- 3. القسمة للمقارنة
			RETURN 
			1-(DIVIDE(Current_Class_SD, Avg_SD_Across_All_Classes))
			```
		lineageTag: 6c444e2e-efde-411b-9cea-f703988ed327

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Class_Percentile_Rank = ```
			
			VAR CurrentAvg = [Class_avg]
			VAR AllClasses = ALL(CS1_Marks[Class])
			VAR TotalClasses = COUNTROWS(AllClasses)
			VAR RankOfClass = 
			    RANKX(
			        AllClasses, 
			        [Class_Avg], 
			        CurrentAvg, 
			        ASC
			    )
			RETURN
			DIVIDE(RankOfClass, TotalClasses)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8c2a2f54-2937-4254-b091-d92c71bf640c

	measure Class_Failure_Rate =
			
			DIVIDE(
			    CALCULATE(COUNT(CS1_Marks[Student_id]), CS1_Marks[Passed] = "0"),
			    COUNT(CS1_Marks[Student_id])
			)
		formatString: 0
		lineageTag: f646241c-0c89-404f-bcf9-3af91c193967

	measure Class_Benchmark_Avg = ```
			
			AVERAGEX(
			    ALL(CS1_Marks[Class]), 
			    [Class_Avg]
			)
			```
		lineageTag: 661bc005-cfc2-41a1-92fd-92db8579c4aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Class_Benchmark_SD = ```
			
			AVERAGEX(
			    ALL(CS1_Marks[Class]), 
			    CALCULATE(STDEV.P(CS1_Marks[Mark_100]))
			)
			```
		lineageTag: 01f166c3-7e0a-4459-95b6-a9e9c756e2b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Adj_mark_100_Measure = ```
			
			VAR Scenario = SELECTEDVALUE(Scenario_Table[Scenario_id], 0)
			RETURN 
			SUMX(
			    CS1_Marks,
			    SWITCH(
			        Scenario,
			        0, CS1_Marks[Mark_100],
			        
			        1, IF(
			            CS1_Marks[Cause_of_Failure] = "Failure due to only 40",
			            MIN(CS1_Marks[Mark_40] + 3, 40) + CS1_Marks[Mark_60],
			            CS1_Marks[Mark_100]
			        ),
			        
			        2, IF(
			             CS1_Marks[Passed] = FALSE() && CS1_Marks[Mark_60] >= 28,
			             MIN(CS1_Marks[Mark_40] + 2, 40) + CS1_Marks[Mark_60], 
			             CS1_Marks[Mark_100]
			        ),
			        CS1_Marks[Mark_100]
			    )
			)
			```
		formatString: 0
		lineageTag: 7b5145f1-f94c-45dc-8ac4-814e5fb89e05

	measure Adj_Pass_Rate =
			DIVIDE(
			                        COUNTROWS(FILTER(CS1_Marks, [Adj_mark_100_Measure] >= 50)),
			                        COUNTROWS(CS1_Marks)
			)
		lineageTag: 0d681c10-31a4-4117-aba2-a90e5e311b52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Adj_Fail_Rate = 1 -  [Adj_Pass_Rate]
		lineageTag: 4c5390b9-b7f4-4ea5-b6c8-e8f0e82937e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Adj_Student_Count = COUNTROWS(FILTER(CS1_Marks, [Adj_mark_100_Measure]))
		formatString: 0
		lineageTag: 845652c4-dc5b-4cf2-bf9b-e34a4aab7d45

